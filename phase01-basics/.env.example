# 大模型 API 密钥配置
# 推荐国内直连服务（如 DeepSeek、硅基流动 SiliconFlow、智谱清言）或 OpenAI

# 1. API Key
LLM_API_KEY=your_api_key_here

# 2. 接口地址（Base URL）
# 如果用 DeepSeek: https://api.deepseek.com
# 如果用 硅基流动: https://api.siliconflow.cn/v1
# 如果用 智谱清言: https://open.bigmodel.cn/api/paas/v4
# 如果用 官方OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com

# 3. 调用的模型名称
# DeepSeek: deepseek-chat
# 硅基流动: deepseek-ai/DeepSeek-V3 (或 Qwen 系列)
# 官方OpenAI: gpt-4o-mini
LLM_MODEL=deepseek-chat
