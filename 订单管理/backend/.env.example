# 模板文件不自动加载。当前项目自动复用上一级学习仓库中的真实 .env。
# 独立运行时可复制为 backend/.env，填写自己的配置。不要将密钥写入前端。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=
ORDER_DEBUG=false
ORDER_DATABASE_URL=sqlite:///./data/orders.db
ORDER_MODEL_TIMEOUT=60
ORDER_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
